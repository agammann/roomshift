    "@playwright/test": "1.64.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.181.0",
    "@vitejs/plugin-react": "5.0.4",
    "three-viewport-gizmo": "2.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
